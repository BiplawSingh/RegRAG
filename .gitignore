# Secrets. .env holds real API keys; .env.example is the committed template.
# Never remove this line.
.env
.env.local

# Personal / not for a public repo
applied-ai-switch-schedule.md

# Blog posts — drafted here, published elsewhere; not pushed
blog/

# Personal study notes — for interview prep, not part of the project
notes/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / agent local state
.claude/
.vscode/
.idea/

# Derived artifacts — regenerate with `python chunker.py` / `python embed.py build`
data/chunks.jsonl
data/embeddings.npy
data/qdrant/

# Context-prefixed embeddings, for the `dense-ctx` retrieval experiment only.
# That variant lost (see README), so nothing in the pipeline reads this -- but
# `retrieval_lab.py build-context-vectors` regenerates it if the result is ever
# worth re-checking.
data/embeddings_ctx.npy

# PDF downloads: rbidocs.rbi.org.in sits behind a WAF that returns challenge
# pages, so this stays empty. The corpus comes from data/html/ instead.
data/circulars/

# Symlink category views, rebuilt by `python rbi_scraper.py organize`
data/by_category/

# Q&A run history: grows on every question asked, and the latest batch snapshot
# is redundant with it. Local runtime data, not corpus data -- not committed.
data/log.jsonl
data/answers.jsonl

# The ground-truth question set IS committed -- it's hand-written work and the
# thing every eval number is measured against, so it belongs in version control.
!data/qa_draft.yaml
!data/qa.jsonl

# Evaluation results ARE committed: they are the evidence behind every number in
# the README, and a claim you cannot re-open is a claim nobody can check. They are
# small (~350 KB) and append-only in practice.
!data/eval/
# Terminal captures from `tee` during a run are not results.
data/eval/*.log
