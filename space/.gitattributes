# Hugging Face requires files over 10MB to be tracked with git-lfs, and both of
# the corpus files are: chunks.jsonl is ~13MB, embeddings.npy ~14MB. This file has
# to exist BEFORE the first commit -- adding LFS tracking after a large file is
# already committed means rewriting history, which is a bad first five minutes.
*.npy   filter=lfs diff=lfs merge=lfs -text
*.jsonl filter=lfs diff=lfs merge=lfs -text
