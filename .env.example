# Copy to .env and fill in.  `cp .env.example .env`
#
# .env is git-ignored; this template is committed. Never put a real key in this
# file -- it goes to the public repo.
#
# Anything already exported in your shell wins over .env, so you can override a
# single value for one run without editing anything:
#     GEMINI_MODEL=gemini-2.5-flash python rag.py ask "..."

# ---------------------------------------------------------------- generation --
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model answers questions. The free tier meters requests per day *per
# model*, so daily allowance matters more than raw quality here -- check yours at
# https://aistudio.google.com/rate-limit, and `python rag.py models` for the list.
GEMINI_MODEL=gemini-3.5-flash-lite

# ----------------------------------------------------------------- retrieval --
# Where Qdrant is listening. Start it with:
#   docker run -d --name qdrant -p 6333:6333 -v qdrant_storage:/qdrant/storage qdrant/qdrant
QDRANT_URL=http://localhost:6333

# --------------------------------------------------------------- observability --
# Free project: https://cloud.langfuse.com  -> Settings -> API Keys
# Leave blank to run without tracing; the pipeline is unaffected either way.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# -------------------------------------------------------------------- scraper --
# Sent in the User-Agent when harvesting from rbi.org.in. Scraping courtesy wants
# a reachable contact; it is read from here so it never lands in committed source.
# Only needed if you re-run `python rbi_scraper.py harvest`.
SCRAPER_CONTACT=
