# Copy to .env and fill in.  `cp .env.example .env`
#
# .env is git-ignored; this template is committed. Never put a real key in this
# file -- it goes to the public repo.
#
# Anything already exported in your shell wins over .env, so you can override a
# single value for one run without editing anything:
#     GROQ_MODEL=openai/gpt-oss-20b python rag.py ask "..."

# ---------------------------------------------------------------- generation --
# Free key: https://console.groq.com -> API Keys
GROQ_API_KEY=

# Which model answers questions. Needs strict JSON-schema support, which on the
# free tier means openai/gpt-oss-120b or openai/gpt-oss-20b.
# `python rag.py models` lists what your key can call.
GROQ_MODEL=openai/gpt-oss-120b

# Free-tier tokens-per-minute ceiling; the client paces itself against this.
# Limits are per model and published at https://console.groq.com/docs/rate-limits
# -- note tokens/day (200,000) binds long before requests/day (1,000).
GROQ_TPM_LIMIT=8000

# Output budget per answer. Set this too low and generation fails outright rather
# than returning a shorter answer: strict JSON schema needs the object to close,
# so a reply cut off mid-string is rejected whole with a 400. gpt-oss models spend
# reasoning tokens from this same budget, so it must cover thinking plus answer.
# Measured on this corpus: median 644 output tokens, p90 1366, longest 2311.
GROQ_MAX_OUTPUT_TOKENS=4096

# ----------------------------------------------------------------- retrieval --
# Where Qdrant is listening. Start it with:
#   docker run -d --name qdrant -p 6333:6333 -v qdrant_storage:/qdrant/storage qdrant/qdrant
QDRANT_URL=http://localhost:6333

# ----------------------------------------------------------------------- api --
# Only read by `uvicorn api.main:app`. Defaults suit local development.
#
# Which web origins may call the API from a browser, comma-separated. Add the
# deployed frontend's URL here, e.g. https://regrag.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# How many trusted proxies sit in front of the server. 0 locally; 1 behind a
# single reverse proxy. Rate limits key on the visitor's IP, and this is how
# many X-Forwarded-For entries (from the right) can be believed.
FORWARDED_HOPS=0

# Rate limits. Requests over the first are refused with 429; generations over
# the others fall back to retrieval-only. Sized to the Groq free tier:
# ~200,000 tokens/day is ~70 answers, and 8,000 tokens/min is ~3 a minute.
RATE_IP_PER_MINUTE=5
RATE_IP_GENERATIONS_PER_DAY=20
RATE_GENERATIONS_PER_MINUTE=3
RATE_GENERATIONS_PER_DAY=60

# --------------------------------------------------------------- observability --
# Free project: https://cloud.langfuse.com  -> Settings -> API Keys
# Leave blank to run without tracing; the pipeline is unaffected either way.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# -------------------------------------------------------------------- scraper --
# Sent in the User-Agent when harvesting from rbi.org.in. Scraping courtesy wants
# a reachable contact; it is read from here so it never lands in committed source.
# Only needed if you re-run `python rbi_scraper.py harvest`.
SCRAPER_CONTACT=
